# ─────────────────────────────────────────────────────────────────────────────
# Overleaf MCP server — configuration
#
# Copy to `.env` and fill in. Never commit the filled-in file.
# Run `node dist/index.js --check` to validate without starting.
# ─────────────────────────────────────────────────────────────────────────────

# ── Overleaf credentials (required) ──────────────────────────────────────────
# The session cookie value, NOT your password.
# In Overleaf: open any project → DevTools → Application → Cookies → copy the value of
# `overleaf_session2`. On self-hosted instances the cookie is usually `sharelatex.sid`.
# This is a full-account credential: it is stored only in this process's memory and is
# never written to disk or sent to the model.
OVERLEAF_SESSION=

# Self-hosted Overleaf/ShareLaTeX only: allows silent re-login when the cookie expires.
# OVERLEAF_EMAIL=
# OVERLEAF_PASSWORD=

# Point at your own instance if you are not using overleaf.com.
OVERLEAF_BASE_URL=https://www.overleaf.com
# OVERLEAF_COOKIE_NAME=sharelatex.sid

# Optional: pre-select a project so tools work without a `use_project` call.
# OVERLEAF_DEFAULT_PROJECT=My Thesis

# ── Public address ───────────────────────────────────────────────────────────
# Must be the exact public https origin. Clients are clouds, not browsers, so this has to
# resolve from the internet. OAuth discovery metadata is built from this value.
PUBLIC_URL=https://mcp.example.com

HOST=0.0.0.0
PORT=8080

# ── Authentication ───────────────────────────────────────────────────────────
# oauth  — required by Gemini, Claude and ChatGPT custom connectors. Recommended.
# bearer — static token. Works for local/CLI clients only: ChatGPT cannot send one,
#          and Gemini's custom-app flow offers no such option.
# none   — public and, unless you opt in below, READ-ONLY. Anyone with the URL can read
#          your projects, so this is only sensible on a private network.
MCP_AUTH_MODE=oauth

# Required when MCP_AUTH_MODE=oauth. This is the passphrase you type on the consent
# screen when an assistant asks to connect. Generate one:
#   openssl rand -base64 24
MCP_OAUTH_PASSWORD=

# Extra allowed callback URLs, comma-separated and matched EXACTLY. Prefer this: a URL
# compared as a string cannot accidentally accept a neighbouring host.
# Claude, ChatGPT, Gemini and loopback clients are already allowed.
# MCP_OAUTH_REDIRECT_URLS=https://my-tool.example.com/oauth/callback

# Extra callback patterns, comma-separated regular expressions.
# These are matched as regexes, so a "." matches any character: write \. for a literal dot.
# Each pattern must be anchored ^...$ or the server refuses to start, because an unanchored
# pattern also matches a URL that merely *contains* the callback as a parameter.
# MCP_OAUTH_REDIRECT_ALLOWLIST=^https://my-tool\.example\.com/oauth/callback$

# Required when MCP_AUTH_MODE=bearer. Comma-separated.
# Generate with: openssl rand -hex 32
MCP_BEARER_TOKENS=

# MCP_AUTH_MODE=none is read-only by default. Set this to true to let anonymous callers
# write — think carefully first: it means anyone who learns the URL can edit your papers.
OLMCP_ALLOW_ANONYMOUS_WRITE=false

# How many reverse proxies sit in front of this server (Express `trust proxy`).
# 1 matches the Caddy setup in docker/. Set to 0 if the server is exposed directly:
# with a wrong value a client can spoof X-Forwarded-For and evade the rate limiter.
TRUST_PROXY=1

# ── Behaviour ────────────────────────────────────────────────────────────────
# Push every accepted edit to Overleaf immediately, so the change appears in the
# browser within seconds. Set to false to batch edits behind publish_changes.
OLMCP_AUTO_PUSH=true

# Refuse every mutating tool. Hand a read-only connection to an assistant you do not
# want editing the paper.
OLMCP_READ_ONLY=false

# Fetch a file from Overleaf before reading or editing it, so the model never works from a
# stale copy. This is what stops it overwriting a change you made in the browser: if the
# text it read no longer matches, the edit fails loudly instead of clobbering yours.
# Costs one request per read; set to false only if that latency matters more.
OLMCP_FRESH_READS=true

# Where per-project git mirrors and OAuth state live.
OLMCP_DATA_DIR=./data

# Largest file the model may read or write in one call.
OLMCP_MAX_FILE_BYTES=2097152

# Answer MCP requests with a JSON body (true) or an SSE stream (false).
# true  — right for a same-host reverse proxy (Caddy/nginx), which is the default setup.
# false — REQUIRED behind Cloudflare. Cloudflare returns error 524 when the origin sends
#         nothing for 125 seconds, and a JSON-mode tool call sends nothing until it finishes,
#         so a slow LaTeX compile can trip it. SSE starts responding immediately and streams.
MCP_JSON_RESPONSES=true

# ── Cloudflare Tunnel (docker/docker-compose.cloudflare.yml) ─────────────────
# Only needed for the tunnel setup; see that file's header for the dashboard steps.
# Copy the token from Zero Trust → Networks → Tunnels → your tunnel.
# With a tunnel, PUBLIC_URL is the Cloudflare hostname and MCP_JSON_RESPONSES should be false.
# CF_TUNNEL_TOKEN=

# debug | info | warn | error   (logs go to stderr)
LOG_LEVEL=info